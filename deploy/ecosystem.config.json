{
  "name": "prodi-unusu",
  "script": "dist/server/server.js",
  "cwd": "/var/www/prodi-unusu",
  "instances": 1,
  "exec_mode": "fork",
  "autorestart": true,
  "watch": false,
  "max_memory_restart": "512M",
  "env": {
    "NODE_ENV": "production",
    "PORT": "5010",
    "TRUST_PROXY": "true"
  },
  "error_file": "/var/log/pm2/prodi-unusu-error.log",
  "out_file": "/var/log/pm2/prodi-unusu-out.log",
  "merge_logs": true,
  "time": true
}
