// =========================================================
// UNUSU Multi-Prodi Website Management System
// Prisma Schema — MySQL
//
// Aturan isolasi (docs/DATABASE.md bagian 4):
//   Setiap record milik tenant punya studyProgramId eksplisit atau dapat
//   diturunkan lewat relasi yang tervalidasi. Tidak ada query tenant yang
//   boleh mempercayai studyProgramId dari browser.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. Organisasi & Multi-Tenancy
// ---------------------------------------------------------

model Faculty {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  studyPrograms       StudyProgram[]
  users               User[]
  userRoleAssignments UserRole[]
  permissionGroups    PermissionGroup[]

  @@index([isActive, sortOrder])
  @@map("faculties")
}

model StudyProgram {
  id          Int      @id @default(autoincrement())
  facultyId   Int      @map("faculty_id")
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  degree      String   @default("S1") @db.VarChar(10)
  description String?  @db.Text
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  status      String   @default("active") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  faculty             Faculty           @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  domains             Domain[]
  userRoleAssignments UserRole[]
  websiteSetting      WebsiteSetting?
  theme               Theme?
  menus               Menu[]
  pages               Page[]
  curriculums         Curriculum[]
  lecturers           Lecturer[]
  documents           Document[]
  facilities          Facility[]
  posts               Post[]
  postCategories      PostCategory[]
  galleries           Gallery[]
  contactInfo         ContactInfo?
  messages            ContactMessage[]
  auditLogs           AuditLog[]
  mediaAssets         MediaAsset[]
  permissionGroups    PermissionGroup[]
  ProfileContent      ProfileContent?
  VisionMission       VisionMission?

  @@index([facultyId])
  @@index([status])
  @@map("study_programs")
}

model Domain {
  id             Int       @id @default(autoincrement())
  studyProgramId Int       @map("study_program_id")
  hostname       String    @unique @db.VarChar(255)
  isPrimary      Boolean   @default(false) @map("is_primary")
  isActive       Boolean   @default(true) @map("is_active")
  sslIssuedAt    DateTime? @map("ssl_issued_at")
  sslExpiresAt   DateTime? @map("ssl_expires_at")
  lastCheckedAt  DateTime? @map("last_checked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@index([studyProgramId])
  @@index([isActive])
  @@map("domains")
}

// ---------------------------------------------------------
// 2. Identitas Pengguna & RBAC
// ---------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  ssoId        String?   @unique @map("sso_id") @db.VarChar(100)
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(190)
  username     String    @unique @db.VarChar(100)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  phone        String?   @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles   UserRole[]
  auditLogs   AuditLog[]
  mediaAssets MediaAsset[]
  postAuthors Post[]       @relation("PostAuthor")
  sessions    Session[]
  Faculty     Faculty?     @relation(fields: [facultyId], references: [id])
  facultyId   Int?

  @@index([isActive])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     Int    @id @default(autoincrement())
  code   String @unique @db.VarChar(100)
  name   String @db.VarChar(150)
  module String @db.VarChar(50)

  rolePermissions      RolePermission[]
  permissionGroupItems PermissionGroupItem[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  roleId         Int      @map("role_id")
  scopeType      String   @default("prodi") @map("scope_type") @db.VarChar(20) // global, faculty, prodi
  studyProgramId Int?     @map("study_program_id")
  facultyId      Int?     @map("faculty_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                    Role                      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  studyProgram            StudyProgram?             @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  faculty                 Faculty?                  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  UserRolePermissionGroup UserRolePermissionGroup[]

  @@unique([userId, roleId, scopeType, studyProgramId, facultyId], name: "user_role_scope_unique")
  @@index([userId])
  @@index([studyProgramId])
  @@index([facultyId])
  @@map("user_roles")
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Preset hak akses Editor (docs/rbac/ROLE-PERMISSION-MENU-PRD.md bagian 7)
model PermissionGroup {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  studyProgramId Int?     @map("study_program_id")
  facultyId      Int?     @map("faculty_id")
  isSystem       Boolean  @default(true) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram?             @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  faculty      Faculty?                  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  items        PermissionGroupItem[]
  userRoles    UserRolePermissionGroup[]

  @@index([studyProgramId])
  @@map("permission_groups")
}

model PermissionGroupItem {
  id                Int @id @default(autoincrement())
  permissionGroupId Int @map("permission_group_id")
  permissionId      Int @map("permission_id")

  permissionGroup PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  permission      Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionGroupId, permissionId])
  @@map("permission_group_items")
}

// Pemberian permission group kepada assignment role seorang user.
model UserRolePermissionGroup {
  id                Int @id @default(autoincrement())
  userRoleId        Int @map("user_role_id")
  permissionGroupId Int @map("permission_group_id")

  userRole        UserRole        @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  permissionGroup PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([userRoleId, permissionGroupId])
  @@map("user_role_permission_groups")
}

// Sesi login httpOnly cookie. Satu baris per perangkat agar dapat dicabut.
model Session {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenId   String    @unique @map("token_id") @db.VarChar(64)
  csrfToken String    @map("csrf_token") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(60)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------
// 3. Identitas Website, Tema & Navigasi
// ---------------------------------------------------------

// Slide hero untuk Portal Utama (website universitas).
//
// Berbeda dari hero slider prodi yang tersimpan pada konfigurasi widget di
// Page Builder, slide portal bersifat global (lintas tenant) sehingga tidak
// memakai `studyProgramId`. Data ini dibaca beranda utama (`MainLandingPage`)
// dan dikelola Super Admin dari panel admin.
model PortalHeroSlide {
  id          Int      @id @default(autoincrement())
  imageUrl    String   @map("image_url") @db.VarChar(500)
  alt         String?  @db.VarChar(255)
  linkUrl     String?  @map("link_url") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("portal_hero_slides")
}

model WebsiteSetting {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @unique @map("study_program_id")
  siteTitle      String   @map("site_title") @db.VarChar(200)
  siteTagline    String?  @map("site_tagline") @db.VarChar(255)
  univName       String   @default("Universitas Nahdlatul Ulama Sumatera Utara") @map("univ_name") @db.VarChar(200)
  facultyName    String?  @map("faculty_name") @db.VarChar(200)
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(500)
  seoTitle       String?  @map("seo_title") @db.VarChar(200)
  seoDescription String?  @map("seo_description") @db.Text
  seoKeywords    String?  @map("seo_keywords") @db.VarChar(500)
  seoImageUrl    String?  @map("seo_image_url") @db.VarChar(500)
  copyrightText  String?  @map("copyright_text") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

model Theme {
  id              Int      @id @default(autoincrement())
  studyProgramId  Int      @unique @map("study_program_id")
  primaryColor    String   @default("#1e3a8a") @map("primary_color") @db.VarChar(20)
  secondaryColor  String   @default("#0f172a") @map("secondary_color") @db.VarChar(20)
  accentColor     String   @default("#fbbf24") @map("accent_color") @db.VarChar(20)
  backgroundColor String   @default("#FFFFFF") @map("background_color") @db.VarChar(20)
  foregroundColor String   @default("#111827") @map("foreground_color") @db.VarChar(20)
  fontHeading     String   @default("Plus Jakarta Sans") @map("font_heading") @db.VarChar(100)
  fontBody        String   @default("Plus Jakarta Sans") @map("font_body") @db.VarChar(100)
  radius          String   @default("0.75rem") @db.VarChar(30)
  shadow          String   @default("sm") @db.VarChar(30)
  buttonStyle     String   @default("solid") @map("button_style") @db.VarChar(30)
  headerLayout    String   @default("modern") @map("header_layout") @db.VarChar(30)
  footerLayout    String   @default("multi-column") @map("footer_layout") @db.VarChar(30)
  containerWidth  String   @default("1280px") @map("container_width") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@map("themes")
}

model Menu {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  parentId       Int?     @map("parent_id")
  title          String   @db.VarChar(100)
  url            String   @db.VarChar(500)
  target         String   @default("_self") @db.VarChar(20)
  sortOrder      Int      @default(0) @map("sort_order")
  isRequired     Boolean  @default(false) @map("is_required")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  parent       Menu?        @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Menu[]       @relation("MenuHierarchy")

  @@index([studyProgramId, isActive, sortOrder])
  @@index([parentId])
  @@map("menus")
}

// ---------------------------------------------------------
// 4. Page Builder & Widget Registry
// ---------------------------------------------------------

model Page {
  id             Int       @id @default(autoincrement())
  studyProgramId Int       @map("study_program_id")
  slug           String    @db.VarChar(150)
  title          String    @db.VarChar(200)
  layout         String    @default("default") @db.VarChar(50)
  isSystem       Boolean   @default(false) @map("is_system")
  isPublished    Boolean   @default(false) @map("is_published")
  seoTitle       String?   @map("seo_title") @db.VarChar(200)
  seoDescription String?   @map("seo_description") @db.Text
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  studyProgram StudyProgram  @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  sections     PageSection[]
  versions     PageVersion[]

  @@unique([studyProgramId, slug], name: "page_tenant_slug_unique")
  @@index([studyProgramId, isPublished])
  @@map("pages")
}

// Snapshot publikasi. Isi versi published dibaca oleh website publik.
model PageVersion {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  version     Int
  status      String   @default("draft") @db.VarChar(20) // draft, published, archived
  snapshot    String   @db.LongText
  createdById Int?     @map("created_by_id")
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, status])
  @@map("page_versions")
}

model PageSection {
  id         Int      @id @default(autoincrement())
  pageId     Int      @map("page_id")
  title      String?  @db.VarChar(200)
  sectionKey String   @map("section_key") @db.VarChar(100)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  configJson String?  @map("config_json") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  page    Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  widgets SectionWidget[]

  @@index([pageId, isActive, sortOrder])
  @@map("page_sections")
}

// Master widget yang dikelola Super Admin.
model Widget {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(100)
  name         String   @db.VarChar(150)
  category     String   @db.VarChar(50)
  description  String?  @db.Text
  configSchema String?  @map("config_schema") @db.Text
  defaultJson  String   @map("default_json") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sectionWidgets SectionWidget[]
  variants       WidgetVariant[]

  @@index([category, isActive])
  @@map("widgets")
}

model WidgetVariant {
  id         Int      @id @default(autoincrement())
  widgetId   Int      @map("widget_id")
  code       String   @db.VarChar(100)
  name       String   @db.VarChar(150)
  previewUrl String?  @map("preview_url") @db.VarChar(500)
  configJson String?  @map("config_json") @db.Text
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, code])
  @@map("widget_variants")
}

model SectionWidget {
  id            Int      @id @default(autoincrement())
  pageSectionId Int      @map("page_section_id")
  widgetId      Int      @map("widget_id")
  variantCode   String?  @map("variant_code") @db.VarChar(100)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  configJson    String   @map("config_json") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pageSection PageSection @relation(fields: [pageSectionId], references: [id], onDelete: Cascade)
  widget      Widget      @relation(fields: [widgetId], references: [id], onDelete: Restrict)

  @@index([pageSectionId, isActive, sortOrder])
  @@map("section_widgets")
}

// ---------------------------------------------------------
// 5. Media Library
// ---------------------------------------------------------

model MediaAsset {
  id             Int      @id @default(autoincrement())
  studyProgramId Int?     @map("study_program_id")
  uploadedById   Int?     @map("uploaded_by_id")
  filename       String   @db.VarChar(255)
  storageKey     String   @unique @map("storage_key") @db.VarChar(500)
  mimeType       String   @map("mime_type") @db.VarChar(120)
  sizeBytes      Int      @map("size_bytes")
  altText        String?  @map("alt_text") @db.VarChar(255)
  isPublic       Boolean  @default(true) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")

  studyProgram StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([studyProgramId, isPublic])
  @@map("media_assets")
}

// ---------------------------------------------------------
// 6. Modul CMS
// ---------------------------------------------------------

model Curriculum {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  name           String   @db.VarChar(200)
  year           Int
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram         @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  semesters    CurriculumSemester[]

  @@unique([studyProgramId, year])
  @@index([studyProgramId, isActive])
  @@map("curriculums")
}

model CurriculumSemester {
  id             Int      @id @default(autoincrement())
  curriculumId   Int      @map("curriculum_id")
  semesterNumber Int      @map("semester_number")
  title          String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  curriculum Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  courses    CurriculumCourse[]

  @@unique([curriculumId, semesterNumber])
  @@map("curriculum_semesters")
}

model CurriculumCourse {
  id          Int      @id @default(autoincrement())
  semesterId  Int      @map("semester_id")
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(200)
  credits     Int      @default(3)
  courseType  String   @default("Wajib") @map("course_type") @db.VarChar(30)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  semester     CurriculumSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  rpsDocuments RpsDocument[]

  @@index([semesterId, sortOrder])
  @@index([code])
  @@map("curriculum_courses")
}

model RpsDocument {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  title     String   @db.VarChar(200)
  fileUrl   String   @map("file_url") @db.VarChar(500)
  revision  String?  @db.VarChar(50)
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course CurriculumCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("rps_documents")
}

model Lecturer {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  name           String   @db.VarChar(200)
  nidn           String?  @db.VarChar(30)
  academicRank   String?  @map("academic_rank") @db.VarChar(100)
  education      String?  @db.VarChar(200)
  expertise      String?  @db.VarChar(200)
  email          String?  @db.VarChar(190)
  photoUrl       String?  @map("photo_url") @db.VarChar(500)
  bio            String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@index([studyProgramId, isActive, sortOrder])
  @@index([nidn])
  @@map("lecturers")
}

model Document {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  code           String?  @db.VarChar(50)
  title          String   @db.VarChar(255)
  category       String   @db.VarChar(100)
  description    String?  @db.Text
  year           Int      @default(2026)
  fileUrl        String   @map("file_url") @db.VarChar(500)
  fileSize       Int?     @map("file_size")
  mimeType       String?  @map("mime_type") @db.VarChar(120)
  isPublic       Boolean  @default(true) @map("is_public")
  downloadCount  Int      @default(0) @map("download_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@index([studyProgramId, isPublic])
  @@index([category])
  @@map("documents")
}

model Facility {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  name           String   @db.VarChar(200)
  category       String   @default("Laboratorium") @db.VarChar(100)
  location       String?  @db.VarChar(200)
  description    String?  @db.Text
  imageUrl       String?  @map("image_url") @db.VarChar(500)
  status         String   @default("aktif") @db.VarChar(30)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@index([studyProgramId, category])
  @@map("facilities")
}

model PostCategory {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  name           String   @db.VarChar(100)
  slug           String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  posts        Post[]

  @@unique([studyProgramId, slug])
  @@map("post_categories")
}

model Post {
  id             Int       @id @default(autoincrement())
  studyProgramId Int       @map("study_program_id")
  categoryId     Int?      @map("category_id")
  authorId       Int?      @map("author_id")
  title          String    @db.VarChar(255)
  slug           String    @db.VarChar(255)
  excerpt        String?   @db.Text
  content        String    @db.LongText
  thumbnailUrl   String?   @map("thumbnail_url") @db.VarChar(500)
  seoTitle       String?   @map("seo_title") @db.VarChar(200)
  seoDescription String?   @map("seo_description") @db.Text
  status         String    @default("draft") @db.VarChar(20) // draft, scheduled, published, archived
  isPublished    Boolean   @default(false) @map("is_published")
  views          Int       @default(0)
  publishedAt    DateTime? @map("published_at")
  scheduledAt    DateTime? @map("scheduled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  studyProgram StudyProgram  @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  category     PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([studyProgramId, slug], name: "post_tenant_slug_unique")
  @@index([studyProgramId, status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

model Gallery {
  id             Int       @id @default(autoincrement())
  studyProgramId Int       @map("study_program_id")
  title          String    @db.VarChar(200)
  slug           String    @db.VarChar(200)
  description    String?   @db.Text
  category       String?   @db.VarChar(100)
  eventDate      DateTime? @map("event_date")
  coverImageUrl  String?   @map("cover_image_url") @db.VarChar(500)
  isPublished    Boolean   @default(true) @map("is_published")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  studyProgram StudyProgram  @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)
  items        GalleryItem[]

  @@unique([studyProgramId, slug], name: "gallery_tenant_slug_unique")
  @@index([studyProgramId, isPublished])
  @@map("galleries")
}

model GalleryItem {
  id        Int      @id @default(autoincrement())
  galleryId Int      @map("gallery_id")
  caption   String?  @db.VarChar(255)
  mediaType String   @default("image") @map("media_type") @db.VarChar(20)
  mediaUrl  String   @map("media_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
  @@map("gallery_items")
}

model ContactInfo {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @unique @map("study_program_id")
  address        String?  @db.Text
  email          String?  @db.VarChar(190)
  phone          String?  @db.VarChar(50)
  whatsapp       String?  @db.VarChar(50)
  mapsEmbedUrl   String?  @map("maps_embed_url") @db.Text
  instagramUrl   String?  @map("instagram_url") @db.VarChar(500)
  facebookUrl    String?  @map("facebook_url") @db.VarChar(500)
  youtubeUrl     String?  @map("youtube_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@map("contact_infos")
}

model ContactMessage {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @map("study_program_id")
  name           String   @db.VarChar(150)
  email          String   @db.VarChar(190)
  subject        String?  @db.VarChar(200)
  message        String   @db.Text
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@index([studyProgramId, isRead])
  @@map("contact_messages")
}

// Profil dan Visi Misi disimpan terstruktur per tenant.
model ProfileContent {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @unique @map("study_program_id")
  history        String?  @db.Text
  overview       String?  @db.Text
  objectives     String?  @db.Text
  targets        String?  @db.Text
  organization   String?  @db.Text
  heroImageUrl   String?  @map("hero_image_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@map("profile_contents")
}

model VisionMission {
  id             Int      @id @default(autoincrement())
  studyProgramId Int      @unique @map("study_program_id")
  vision         String?  @db.Text
  missions       String?  @db.Text
  objectives     String?  @db.Text
  strategicGoals String?  @map("strategic_goals") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  studyProgram StudyProgram @relation(fields: [studyProgramId], references: [id], onDelete: Cascade)

  @@map("visions_missions")
}

// ---------------------------------------------------------
// 7. Sistem
// ---------------------------------------------------------

model AuditLog {
  id             Int      @id @default(autoincrement())
  studyProgramId Int?     @map("study_program_id")
  userId         Int?     @map("user_id")
  action         String   @db.VarChar(50)
  module         String   @db.VarChar(50)
  targetType     String?  @map("target_type") @db.VarChar(50)
  targetId       String?  @map("target_id") @db.VarChar(50)
  details        String?  @db.Text
  ipAddress      String?  @map("ip_address") @db.VarChar(60)
  createdAt      DateTime @default(now()) @map("created_at")

  studyProgram StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([studyProgramId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
  @@map("audit_logs")
}

// Menu admin dinamis. Sumber pemeriksaan tetap endpoint backend.
model AdminMenu {
  id                 Int      @id @default(autoincrement())
  menuKey            String   @unique @map("menu_key") @db.VarChar(100)
  label              String   @db.VarChar(100)
  route              String   @db.VarChar(200)
  icon               String?  @db.VarChar(50)
  parentKey          String?  @map("parent_key") @db.VarChar(100)
  sortOrder          Int      @default(0) @map("sort_order")
  requiredPermission String?  @map("required_permission") @db.VarChar(100)
  scopeType          String   @default("prodi") @map("scope_type") @db.VarChar(20)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([parentKey, sortOrder])
  @@map("admin_menus")
}

model Notification {
  id             Int       @id @default(autoincrement())
  studyProgramId Int?      @map("study_program_id")
  userId         Int?      @map("user_id")
  title          String    @db.VarChar(200)
  body           String?   @db.Text
  level          String    @default("info") @db.VarChar(20)
  isRead         Boolean   @default(false) @map("is_read")
  createdAt      DateTime  @default(now()) @map("created_at")
  readAt         DateTime? @map("read_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(50)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
