# =========================================================
# UNUSU Multi-Prodi Website Management System
# Salin file ini menjadi .env lalu lengkapi nilainya.
# Jangan commit .env yang berisi secret.
# =========================================================

NODE_ENV=development
PORT=5010

# --- Database MySQL lokal ---
DATABASE_URL="mysql://root:@localhost:3306/prodi_unusu_db"

# --- JWT sesi ---
# Wajib diisi. Buat dengan: openssl rand -hex 32
JWT_SECRET="<generate-with-openssl-rand-hex-32>"
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=prodi-unusu

# --- Cookie sesi ---
COOKIE_NAME=unusu_prodi_session
CSRF_COOKIE_NAME=unusu_prodi_csrf
# Di production isi .unusu.ac.id agar sesi berlaku lintas subdomain portal.
COOKIE_DOMAIN=

# --- Proxy ---
# Wajib true di production bila aplikasi di belakang Nginx, supaya alamat IP
# pengunjung dan protokol asli terbaca benar. Biarkan false bila port aplikasi
# dapat diakses langsung dari internet.
TRUST_PROXY=false

# --- Pratinjau lokal ---
# Memetakan localhost ke satu tenant agar website prodi dapat dibuka tanpa
# domain asli. WAJIB false di production.
ALLOW_LOCAL_PREVIEW=false
PREVIEW_HOST=

# --- Origin yang diizinkan mengirim cookie ---
CORS_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5182

# --- Pemisahan permukaan website ---
# Hostname portal administrasi pusat.
ADMIN_HOST=prodi.unusu.ac.id
# Hostname website utama universitas (dipisahkan koma).
MAIN_SITE_HOSTS=unusu.ac.id,www.unusu.ac.id

# --- SSO ONE UNUSU ---
SSO_BASE_URL=http://localhost:5000
SSO_CLIENT_ID=prodi-unusu
# Rahasia server-ke-server dari portal ONE UNUSU. Jangan pernah masuk repo.
SSO_CLIENT_KEY=
SSO_PORTAL_URL=http://localhost:5173
VITE_ONE_UNUSU_URL=http://localhost:5173
VITE_SSO_CLIENT_ID=prodi-unusu

# --- Upload ---
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# --- Bootstrap Super Admin (hanya dipakai seeder) ---
SEED_SUPERADMIN_EMAIL=admin@unusu.ac.id
SEED_SUPERADMIN_USERNAME=admin
SEED_SUPERADMIN_PASSWORD=

# --- Logging ---
LOG_LEVEL=info

